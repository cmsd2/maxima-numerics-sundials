/* Tests for np_cvode — SUNDIALS CVODE ODE solver */

/* Load packages */
(load("numerics"), true);
true;

(load("numerics-sundials"), true);
true;

(load("tests/test_helpers"), true);
true;

/* === 1. Exponential decay (expression mode) === */
/* dy/dt = -y, y(0) = 1 => y(t) = exp(-t) */
(
  cv_tspan : [0.0, 0.5, 1.0, 1.5, 2.0],
  cv_res1 : np_cvode([-y1], [tt, y1], [1.0], cv_tspan),
  true
);
true;

/* Check shape */
np_shape(cv_res1);
[5, 2];

/* Check time column */
closeto(np_ref(cv_res1, 0, 0), 0.0);
true;

closeto(np_ref(cv_res1, 2, 0), 1.0);
true;

/* Check y(1.0) ≈ exp(-1) ≈ 0.3679 */
closeto(np_ref(cv_res1, 2, 1), float(%e^(-1)), 1e-6);
true;

/* Check y(2.0) ≈ exp(-2) ≈ 0.1353 */
closeto(np_ref(cv_res1, 4, 1), float(%e^(-2)), 1e-6);
true;

/* === 2. Harmonic oscillator (expression mode) === */
/* dx/dt = v, dv/dt = -x, x(0)=1, v(0)=0 => x(t)=cos(t), v(t)=-sin(t) */
(
  cv_tspan2 : makelist(i*0.1, i, 0, 40),
  cv_res2 : np_cvode([cv_v, -cv_x], [tt, cv_x, cv_v], [1.0, 0.0], cv_tspan2),
  true
);
true;

/* Shape: 41 times, 3 columns (t, x, v) */
np_shape(cv_res2);
[41, 3];

/* x(pi) ≈ cos(pi) = -1 */
closeto(np_ref(cv_res2, 31, 1), float(cos(3.1)), 0.01);
true;

/* === 3. Stiff system with BDF method === */
/* dy/dt = -50*y, y(0) = 1 => y(t) = exp(-50*t) */
(
  cv_res3 : np_cvode([-50*y1], [tt, y1], [1.0],
                      [0.0, 0.1, 0.5, 1.0], 1e-8, 1e-8, bdf),
  true
);
true;

closeto(np_ref(cv_res3, 1, 1), float(%e^(-5)), 1e-5);
true;

closeto(np_ref(cv_res3, 2, 1), float(%e^(-25)), 1e-5);
true;

/* === 4. Function mode — exponential decay === */
(
  cv_fn(cv_t, cv_y) := [-np_ref(cv_y, 0)],
  cv_res4 : np_cvode(cv_fn, [1.0], [0.0, 0.5, 1.0, 1.5, 2.0]),
  true
);
true;

np_shape(cv_res4);
[5, 2];

closeto(np_ref(cv_res4, 2, 1), float(%e^(-1)), 1e-6);
true;

/* === 5. Function mode — harmonic oscillator === */
(
  cv_osc(cv_t, cv_y) := [np_ref(cv_y, 1), -np_ref(cv_y, 0)],
  cv_res5 : np_cvode(cv_osc, [1.0, 0.0], makelist(i*0.1, i, 0, 40)),
  true
);
true;

np_shape(cv_res5);
[41, 3];

/* === 6. Function mode — lambda === */
(
  cv_res6 : np_cvode(lambda([cv_t, cv_y], [-np_ref(cv_y, 0)]),
                      [1.0], [0.0, 1.0]),
  true
);
true;

np_shape(cv_res6);
[2, 2];

closeto(np_ref(cv_res6, 1, 1), float(%e^(-1)), 1e-6);
true;

/* === 7. ndarray inputs for y0 and tspan === */
(
  cv_y0nd : ndarray([1.0]),
  cv_tsnd : np_linspace(0.0, 1.0, 5),
  cv_res7 : np_cvode([-y1], [tt, y1], cv_y0nd, cv_tsnd),
  true
);
true;

np_shape(cv_res7);
[5, 2];

/* === 8. BDF function mode === */
(
  cv_res8 : np_cvode(cv_fn, [1.0], [0.0, 0.1, 0.5, 1.0], 1e-8, 1e-8, bdf),
  true
);
true;

closeto(np_ref(cv_res8, 2, 1), float(%e^(-0.5)), 1e-6);
true;

/* === 9. Event detection: bouncing ball === */
/* dy1/dt = y2, dy2/dt = -9.81 (free-fall)
   Event: y1 = 0 (hits ground)
   y1(0) = 10, y2(0) = 0 */
(
  cv_ball : np_cvode([cv_v, -9.81], [tt, cv_h, cv_v], [10.0, 0.0],
                     makelist(i*0.1, i, 0, 30),
                     1e-10, 1e-10, adams, [cv_h]),
  true
);
true;

/* Ball result is [trajectory, events_list] */
is(listp(cv_ball));
true;

/* Trajectory is an ndarray */
is(np_shape(first(cv_ball)) # false);
true;

/* At least one event detected (ground hit) */
is(length(second(cv_ball)) > 0);
true;

/* First event: h=0, time ≈ sqrt(2*10/9.81) ≈ 1.4278 */
(
  cv_ev1 : first(second(cv_ball)),
  closeto(first(cv_ev1), sqrt(2*10.0/9.81), 0.01)
);
true;

/* Event index should be [0] (first event function) */
third(cv_ev1);
[0];

/* === 10. Event detection: threshold crossing === */
/* dy/dt = 1 (linear), event: y - 0.5 = 0 => t_event = 0.5 */
(
  cv_threshold : np_cvode([1.0], [tt, y1], [0.0],
                          [0.0, 0.3, 0.7, 1.0],
                          1e-10, 1e-10, adams, [y1 - 0.5]),
  true
);
true;

is(length(second(cv_threshold)) > 0);
true;

/* Event at t ≈ 0.5 */
closeto(first(first(second(cv_threshold))), 0.5, 1e-6);
true;

/* === 11. Multiple events === */
/* dy/dt = 1, events: [y - 0.3, y - 0.7] */
(
  cv_multi : np_cvode([1.0], [tt, y1], [0.0],
                      [0.0, 0.5, 1.0],
                      1e-10, 1e-10, adams, [y1 - 0.3, y1 - 0.7]),
  true
);
true;

/* Should have 2 events */
is(length(second(cv_multi)) >= 2);
true;

/* First event at t ≈ 0.3 (index 0), second at t ≈ 0.7 (index 1) */
closeto(first(first(second(cv_multi))), 0.3, 1e-6);
true;

closeto(first(second(second(cv_multi))), 0.7, 1e-6);
true;

/* === 12. Error: wrong y0 dimension === */
errcatch(np_cvode([-y1, -y2], [tt, y1, y2], [1.0], [0.0, 1.0]));
[];

/* === 13. Error: invalid method === */
errcatch(np_cvode([-y1], [tt, y1], [1.0], [0.0, 1.0], 1e-8, 1e-8, rk45));
[];

/* === 14. Event direction info in returned tuples ===
   y(t) = sin(t) crosses zero falling at t = π and rising at t = 2π.
   Without a direction filter, both should be detected with the right
   sign in the returned events list. */
(
  cv_sin : np_cvode([cos(tt)], [tt, y1], [0.0],
                    [0.0, 7.0],
                    1e-10, 1e-10, adams, [y1]),
  cv_sin_evs : second(cv_sin),
  true
);
true;

/* Two events detected. */
length(cv_sin_evs);
2;

/* First event at t ≈ π, falling (direction = -1). */
closeto(first(first(cv_sin_evs)), float(%pi), 1e-6);
true;

fourth(first(cv_sin_evs));
[-1];

/* Second event at t ≈ 2π, rising (direction = +1). */
closeto(first(second(cv_sin_evs)), float(2*%pi), 1e-6);
true;

fourth(second(cv_sin_evs));
[1];

/* === 15. rootdir filter: falling-only ===
   Same problem but rootdir = [-1] should keep only the t = π crossing. */
(
  cv_sin_falling : np_cvode([cos(tt)], [tt, y1], [0.0],
                            [0.0, 7.0],
                            1e-10, 1e-10, adams,
                            [y1], 5000, [-1]),
  true
);
true;

length(second(cv_sin_falling));
1;

closeto(first(first(second(cv_sin_falling))), float(%pi), 1e-6);
true;

/* === 16. rootdir filter: rising-only ===
   rootdir = [+1] keeps only the t = 2π crossing. */
(
  cv_sin_rising : np_cvode([cos(tt)], [tt, y1], [0.0],
                           [0.0, 7.0],
                           1e-10, 1e-10, adams,
                           [y1], 5000, [1]),
  true
);
true;

length(second(cv_sin_rising));
1;

closeto(first(first(second(cv_sin_rising))), float(2*%pi), 1e-6);
true;

/* === 17. rootdir validation === */
/* rootdir length doesn't match number of events */
errcatch(np_cvode([1.0], [tt, y1], [0.0], [0.0, 1.0],
                  1e-8, 1e-8, adams, [y1 - 0.5], 5000, [-1, 0]));
[];

/* rootdir entry out of range */
errcatch(np_cvode([1.0], [tt, y1], [0.0], [0.0, 1.0],
                  1e-8, 1e-8, adams, [y1 - 0.5], 5000, [3]));
[];

/* === 18. Stateful API: create / step / reinit / close ===
   Bouncing ball using np_cvode_create+step+reinit instead of
   re-creating on each segment.  Reuses the same cvode_mem (and its
   linear solver) across multiple integrations — what CVodeReInit is
   for. */
(
  cv_h : np_cvode_create([y2, -9.81], [tt, y1, y2],
                          [10.0, 0.0],
                          0.0,
                          1e-10, 1e-10, adams,
                          [y1], 5000, [-1]),
  true
);
true;

/* First step: integrate forward to t=10.  An event should fire at
   t ≈ sqrt(20/9.81) ≈ 1.428 (the first ground impact). */
(cv_step1 : np_cvode_step(cv_h, 10.0), true);
true;

/* step result is a 3-element list [t, y_list, events_list]. */
length(cv_step1);
3;

/* At least one event detected during the step. */
is(length(cv_step1[3]) >= 1);
true;

/* First event is the ground hit. */
(cv_first_ev : first(cv_step1[3]),
 closeto(first(cv_first_ev), sqrt(2*10.0/9.81), 0.01));
true;

/* Reinit with the post-bounce state and verify another step works. */
(np_cvode_reinit(cv_h, first(cv_first_ev),
                  [0.0, -0.8 * second(cv_first_ev)[2]]),
 true);
true;

(cv_step2 : np_cvode_step(cv_h, 10.0), true);
true;

/* Second step should detect bounce 2 too. */
is(length(cv_step2[3]) >= 1);
true;

/* Close — frees SUNDIALS resources. */
np_cvode_close(cv_h);
done;

/* Operating on a closed handle errors. */
errcatch(np_cvode_step(cv_h, 1.0));
[];

/* === 19. np_cvode_with_handle: deterministic auto-close ===
   Wraps create + body + close in unwind-protect.  Body should run,
   handle should be freed afterwards. */
(
  cv_wh_result :
    np_cvode_with_handle(
      [[y2, -9.81], [tt, y1, y2], [10.0, 0.0], 0.0,
       1e-10, 1e-10, adams, [y1], 5000, [-1]],
      lambda([h], block([res],
        res : np_cvode_step(h, 2.0),
        first(res[3])[1]))),  /* return the bounce time */
  true
);
true;

/* The bounce time should be ≈ sqrt(20/9.81). */
closeto(cv_wh_result, sqrt(2*10.0/9.81), 0.01);
true;

/* === 20. np_cvode_with_handle: cleanup on error ===
   Body errors with `error(...)' — handle must still get closed.
   We verify by stashing the handle in an outer variable, letting
   the error propagate, and then trying to use the handle: it should
   error because cleanup ran. */
(cv_leaked_h : false, true);
true;

errcatch(
  np_cvode_with_handle(
    [[y2, -9.81], [tt, y1, y2], [10.0, 0.0], 0.0,
     1e-10, 1e-10, adams, [y1]],
    lambda([h],
      cv_leaked_h : h,
      np_cvode_step(h, 2.0),
      error("intentional failure"))));
[];

/* Cleanup ran in unwind-protect → the stashed handle is now closed,
   so any operation on it errors. */
errcatch(np_cvode_step(cv_leaked_h, 1.0));
[];

/* === 21. Root exactly at an output time ===
   dx/dt = 1 from x = 0.5 at t = 0.5, event x - 1: the root falls on
   the output time t = 1.0.  With no direction filter CVODE kept
   returning that root without advancing, and the event list grew
   until the heap ran out.  The root is reported once, and the next
   interval doesn't report it again. */
(cv_r21 : np_cvode([1.0], [tt, y1], [0.5], [0.5, 1.0, 1.5],
                   1e-8, 1e-8, adams, [y1 - 1.0]), true);
true;

length(second(cv_r21));
1;

closeto(first(first(second(cv_r21))), 1.0, 1e-12);
true;

closeto(np_ref(first(cv_r21), 2, 1), 1.5, 1e-10);
true;

/* The same with a direction filter of 0 and with the stateful API. */
length(second(np_cvode([1.0], [tt, y1], [0.5], [0.5, 1.0],
                       1e-8, 1e-8, adams, [y1 - 1.0], 5000, [0])));
1;

block([h : np_cvode_create([1.0], [tt, y1], [0.5], 0.5,
                           1e-8, 1e-8, adams, [y1 - 1.0]), s1, s2],
  s1 : np_cvode_step(h, 1.0),
  s2 : np_cvode_step(h, 1.5),
  np_cvode_close(h),
  [length(third(s1)), length(third(s2)), closeto(first(s2), 1.5, 1e-12)]);
[1, 0, true];

/* === 22. Function mode: f(t,y) of the wrong length ===
   Too many derivatives used to be written past the end of CVODE's ydot
   vector, and too few left the rest stale.  Both are errors now, whether
   the length is wrong from the start or changes during integration. */
errcatch(np_cvode(lambda([tt, yy], [1.0, 2.0]), [1.0], [0.0, 1.0]));
[];

errcatch(np_cvode(lambda([tt, yy], [1.0]), [1.0, 5.0], [0.0, 1.0]));
[];

errcatch(np_cvode(lambda([tt, yy], if tt > 0.5 then [1.0, 1.0] else [1.0]),
                  [1.0], [0.0, 1.0]));
[];

/* A correct function still integrates after those errors. */
closeto(np_ref(np_cvode(lambda([tt, yy], [-np_ref(yy, 0)]), [1.0], [0.0, 1.0]), 1, 1),
        exp(-1.0), 1e-6);
true;

/* === 23. A root just after t0 that CVODE calls "at and very near" ===
   x = 0.26554 at t = 0, moving down at 1.91, event at x = 0.2655164: the
   root is at t = 1.46e-5.  The event function is still exactly 0 a tiny
   step past it, so continuing returned CV_ILL_INPUT ("Root found at and
   very near t") and np_cvode failed.  It now restarts CVODE at the root
   and continues.  (SUNDIALS still prints its own [ERROR] line.)  This is
   a case numerics-soak's cvode_multi_events found; all five crossings
   of the four levels are reported. */
(cv_r23 : np_cvode([fsv1,-(2.1661430664645116)*fsv0],[fst,fsv0,fsv1],ndarray([0.2655443514381704,-1.9144264134349986],[2]),ndarray([0.0,0.8632135929944126,1.7264271859888252,2.5896407789832376,3.4528543719776503],[5]),1e-11,1e-11,adams,[fsv0-(-0.796549274502523),fsv0-(-0.2655164248341743),fsv0-(0.26551642483417426),fsv0-(0.796549274502523)],100000,[0,-1,0,-1]), true);
true;

map(lambda([e], [third(e), fourth(e)]), second(cv_r23));
[[[2], [-1]], [[1], [-1]], [[0], [-1]], [[0], [1]], [[2], [1]]];

closeto(first(first(second(cv_r23))), 1.4587418994595055e-5, 1e-12);
true;

/* The same through the stateful API, with the first target just past
   the root so the second np_cvode_step starts right after it. */
block([h : np_cvode_create([fsv1, -(2.1661430664645116)*fsv0], [fst, fsv0, fsv1],
                           [0.2655443514381704, -1.9144264134349986], 0.0,
                           1e-11, 1e-11, adams,
                           [fsv0 - 0.26551642483417426], 100000, [0]),
       s1, s2],
  s1 : np_cvode_step(h, 1.0e-4),
  s2 : np_cvode_step(h, 3.0),
  np_cvode_close(h),
  [length(third(s1)), length(third(s2))]);
[1, 1];

/* === np_cvode prints no rat: lines ===
   max and min with float constants make Maxima's simplifier print
   "rat: replaced 5.0 by 5/1 = 5.0" while it builds the expression, so
   build the right-hand side quietly and check that np_cvode itself
   (compilation, events and the stateful API) adds none.  %pi keeps a
   max/min argument symbolic until it is floated. */
(cv_captured(f) := block([s : make_string_output_stream()],
   with_stdout(s, f()),
   get_output_stream_string(s)),
 cv_has_rat(f) := is(ssearch("rat:", cv_captured(f)) # false),
 ratprint : false,
 cv_u : max(-5.0, min(5.0, 1.5*%pi*sin(th) + 0.5*cos(th) + 0.2*om)),
 cv_rhs : [om, -9.81*sin(th) - 0.1*om + cv_u],
 cv_ev : max(-1.0, min(1.0, 0.5*%pi*om)),
 ratprint : true,
 true);
true;

/* The capture sees rat lines, so the checks below can fail. */
cv_has_rat(lambda([], max(-5.0, min(5.0, 1.5*th))));
true;

cv_has_rat(lambda([], np_cvode(cv_rhs, [tt, th, om], [float(%pi), 0.0],
                               np_linspace(0, 6, 300), 1e-8, 1e-8)));
false;

cv_has_rat(lambda([], np_cvode(cv_rhs, [tt, th, om], [float(%pi), 0.0],
                               np_linspace(0, 6, 50), 1e-8, 1e-8, bdf, [cv_ev])));
false;

cv_has_rat(lambda([], block([h : np_cvode_create(cv_rhs, [tt, th, om],
                                                 [float(%pi), 0.0], 0.0,
                                                 1e-8, 1e-8, adams, [cv_ev],
                                                 5000, [0])],
                              np_cvode_step(h, 3.0),
                              np_cvode_close(h))));
false;

/* === Expression mode with many states ===
   Maxima 5.50's coerce-float-fun compiled a lambda with one special
   parameter per variable, and from 61 parameters SBCL's compiler failed
   with "NIL is not of type SB-C:TN", so expression mode failed for 60 or
   more states.  du_i/dt = -u_i gives u_i(1) = exp(-1) for every i. */
(cv_decay(n) := block([us : makelist(concat(cv_u_, i), i, 1, n), r],
   r : np_cvode(map("-", us), cons(tt, us), makelist(1.0, n),
                np_linspace(0, 1, 11), 1e-10, 1e-10),
   [np_shape(r), closeto(np_ref(r, 10, 1), exp(-1.0), 1e-7),
    closeto(np_ref(r, 10, n), exp(-1.0), 1e-7)]),
 true);
true;

cv_decay(60);
[[11, 61], true, true];

cv_decay(300);
[[11, 301], true, true];

/* Events take the same path: u_1 = 0.5 at t = log 2, with 80 states. */
block([vs : makelist(concat(cv_v_, i), i, 1, 80), r],
  r : np_cvode(map("-", vs), cons(tt, vs), makelist(1.0, 80),
               np_linspace(0, 2, 21), 1e-10, 1e-10, adams, [vs[1] - 0.5]),
  closeto(first(first(second(r))), log(2.0), 1e-7));
true;

/* Subscripted state variables, 70 of them; the caller's value of
   cv_y[1] is restored afterwards. */
block([ys : makelist(cv_y[i], i, 1, 70), r],
  cv_y[1] : 99,
  r : np_cvode(map("-", ys), cons(tt, ys), makelist(1.0, 70),
               np_linspace(0, 1, 11), 1e-10, 1e-10),
  [closeto(np_ref(r, 10, 1), exp(-1.0), 1e-7), cv_y[1]]);
[true, 99];

/* The stateful API, with 120 states. */
block([ws : makelist(concat(cv_w_, i), i, 1, 120), h, s],
  h : np_cvode_create(map("-", ws), cons(tt, ws), makelist(1.0, 120), 0.0),
  s : np_cvode_step(h, 1.0),
  np_cvode_close(h),
  [closeto(first(s), 1.0, 1e-12), closeto(first(second(s)), exp(-1.0), 1e-7),
   length(second(s))]);
[true, true, 120];
